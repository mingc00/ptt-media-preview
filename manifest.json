{
  "name": "Ptt Media Preview",
  "description": "增強 Ptt 連結預覽體驗",
  "version": "6.2.0",
  "icons": {
    "48": "icon/48.png",
    "128": "icon/128.png",
    "256": "icon/256.png"
  },
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["https://*.imgur.com/*", "https://www.ptt.cc/*", "https://term.ptt.cc/"],
  "browser_specific_settings": {
    "gecko": {
      "id": "{6828ee93-3dd4-48d8-a97c-071248766757}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.ptt.cc/bbs/*"],
      "js": ["dist/web.js"]
    },
    {
      "matches": ["https://term.ptt.cc/"],
      "js": ["dist/term.js"]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "rule_set",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "manifest_version": 3
}
