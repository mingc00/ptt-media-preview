{
  "name": "ptt-media-preview",
  "version": "7.2.1",
  "type": "module",
  "description": "Enhanced Ptt link preview experience",
  "scripts": {
    "build": "node --run build:content",
    "build:content": "vite build --mode web && vite build --mode term && vite build --mode term-native",
    "build:package": "node --run build:content && node scripts/package.mjs",
    "check": "node --run check:format && node --run lint && node --run test && node --run build:package",
    "check:format": "oxfmt --check",
    "format": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "publish:chrome": "node scripts/publish-chrome.mjs",
    "test": "node --test test/*.test.js",
    "version": "node scripts/update-version.mjs && git add manifest.json surge/ptt_media_preview.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mingc00/ptt-media-preview.git"
  },
  "author": "Mingc",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mingc00/ptt-media-preview/issues"
  },
  "homepage": "https://github.com/mingc00/ptt-media-preview#readme",
  "devDependencies": {
    "fflate": "^0.8.3",
    "jsdom": "^30.1.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "vite": "^8.3.0",
    "web-ext": "^10.6.0"
  }
}
