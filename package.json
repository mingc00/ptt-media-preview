{
  "name": "ptt-media-preview",
  "version": "6.2.1",
  "type": "module",
  "description": "Enhanced Ptt link preview experience",
  "scripts": {
    "build": "node --run build:content",
    "build:content": "vite build --mode web && vite build --mode term",
    "build:package": "node --run build:content && node scripts/package.mjs",
    "check": "node --run check:format && node --run lint && node --run build:package",
    "check:format": "oxfmt --check",
    "postversion": "jq --arg version \"$npm_package_version\" '.version = $version' manifest.json > manifest.json.tmp && mv manifest.json.tmp manifest.json",
    "format": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "publish:chrome": "node scripts/publish-chrome.mjs",
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mingc00/ptt-media-preview.git"
  },
  "author": "Mingc",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mingc00/ptt-media-preview/issues"
  },
  "homepage": "https://github.com/mingc00/ptt-media-preview#readme",
  "devDependencies": {
    "fflate": "^0.8.3",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "vite": "^8.2.1",
    "web-ext": "^10.6.0"
  }
}
