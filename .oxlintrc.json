{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true
  },
  "ignorePatterns": ["dist/**"],
  "overrides": [
    {
      "files": ["surge/*.js"],
      "globals": {
        "$done": "readonly",
        "$response": "readonly"
      }
    }
  ]
}
